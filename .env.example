# EmPay Backend Environment Variables
# Copy this to .env and fill in your values

DATABASE_URL="postgresql://postgres:password@localhost:5432/empay_db?schema=public"
JWT_SECRET="empay_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="8h"
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
